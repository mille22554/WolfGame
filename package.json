{
  "name": "werewolf-game",
  "version": "1.0.0",
  "description": "人狼遊戲 - Text-based Werewolf simulation",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/entry.js",
    "test": "node --test --test-concurrency=1 ./dist/game-state.test.js ./dist/snapshot.test.js ./dist/character-session.test.js ./dist/memory.test.js ./dist/engine.test.js ./dist/worker.test.js ./dist/ai-scheduler.test.js ./dist/server.test.js ./dist/full-game.test.js ./dist/human-lobby.test.js ./dist/human-discussion.test.js ./dist/human-night.test.js ./dist/human-reconnect.test.js ./dist/mixed-game.test.js ./dist/server-human.test.js ./dist/llm.test.js ./dist/model-download.test.js ./dist/llama-server.test.js ./dist/lobby.test.js",
    "build:pkg": "node scripts/build-pkg.mjs",
    "smoke:pkg": "node scripts/pkg-smoke.mjs"
  },
  "keywords": [
    "werewolf",
    "game",
    "simulation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "pkg": "^5.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.0",
    "node-llama-cpp": "^3.20.0",
    "ws": "^8.21.3"
  }
}
